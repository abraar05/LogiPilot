# Copy to .env and fill in. Generate a secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LP_SECRET=change-me-to-a-long-random-string
PORT=8787
NODE_ENV=production

# Postgres (optional — without it the server uses a durable file store)
# DATABASE_URL=postgres://user:pass@host:5432/logipilot

# Comma-separated allowed origins for the web app
LP_CORS=https://abraar05.github.io
